-- Dibuja el mundo con la cámara que manda main.script (centro y zoom, en píxeles del
-- mundo de Defold, con y hacia arriba) y encima la interfaz a tamaño de pantalla.

function init(self)
	self.mundo = render.predicate({"tile"})
	self.particulas = render.predicate({"particle"})
	self.gui = render.predicate({"gui"})
	self.texto_debug = render.predicate({"debug_text"})
	self.camara = {x = 960, y = 600, zoom = 1}
	self.limpiar = {
		[graphics.BUFFER_TYPE_COLOR0_BIT] = vmath.vector4(0.07, 0.09, 0.12, 1),
		[graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
		[graphics.BUFFER_TYPE_STENCIL_BIT] = 0,
	}
end

function update(self)
	local w, h = render.get_window_width(), render.get_window_height()
	if w <= 0 or h <= 0 then
		return
	end
	render.set_depth_mask(true)
	render.set_stencil_mask(0xff)
	render.clear(self.limpiar)
	render.set_viewport(0, 0, w, h)

	local c = self.camara
	local mw, mh = w / 2 / c.zoom, h / 2 / c.zoom
	local proyeccion = vmath.matrix4_orthographic(c.x - mw, c.x + mw, c.y - mh, c.y + mh, -10, 10)
	render.set_view(vmath.matrix4())
	render.set_projection(proyeccion)
	render.set_depth_mask(false)
	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.disable_state(graphics.STATE_CULL_FACE)
	render.enable_state(graphics.STATE_BLEND)
	render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	local opciones = {frustum = proyeccion}
	render.draw(self.mundo, opciones)
	render.draw(self.particulas, opciones)
	render.draw_debug3d()

	render.set_view(vmath.matrix4())
	render.set_projection(vmath.matrix4_orthographic(0, w, 0, h, -1, 1))
	render.enable_state(graphics.STATE_STENCIL_TEST)
	render.draw(self.gui)
	render.draw(self.texto_debug)
	render.disable_state(graphics.STATE_STENCIL_TEST)
	render.disable_state(graphics.STATE_BLEND)
end

function on_message(self, message_id, message)
	if message_id == hash("camara") then
		self.camara = {x = message.x, y = message.y, zoom = message.zoom}
	end
end
